<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless bot players for testing a session hosted in the real game, without other people. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SeaPowerMP.Core\SeaPowerMP.Core.csproj" />
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

  <!-- Same transport code as the mod, so the bots exercise the real network path. -->
  <ItemGroup>
    <Compile Include="..\..\src\SeaPowerMP\Net\LiteNetTransport.cs" Link="Linked\LiteNetTransport.cs" />
    <Compile Include="..\..\src\SeaPowerMP\PluginInfo.cs" Link="Linked\PluginInfo.cs" />
  </ItemGroup>
</Project>
